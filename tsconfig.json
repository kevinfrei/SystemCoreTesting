{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "allowJs": false,
    "esModuleInterop": true,
    "noEmit": true,
    "pretty": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
